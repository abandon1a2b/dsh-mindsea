{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "plugins/**/*.ts", "scripts/**/*.ts"]
}
