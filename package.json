{
  "name": "dsh-mindsea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mindsea 脑海: personal mind service with passive Memory and event-driven Future",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "npm run clean && npm run build:server && npm run build:plugin",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write .",
    "build:plugin": "esbuild plugins/dsh-mindsea/src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@deepseek-ai/* --outfile=plugins/dsh-mindsea/lib/index.js",
    "clean": "node scripts/clean.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "lint": "eslint src plugins/dsh-mindsea/src scripts test",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "zod": "$zod"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/abandon1a2b/dsh-mindsea.git"
  },
  "homepage": "https://github.com/abandon1a2b/dsh-mindsea#readme",
  "bugs": {
    "url": "https://github.com/abandon1a2b/dsh-mindsea/issues"
  }
}
